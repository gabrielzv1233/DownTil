# Pterodactyl supplies SERVER_PORT from the primary allocation.
# INTERNAL_IP is the address to bind inside the container, not the public node IP.
INTERNAL_IP=0.0.0.0
SERVER_PORT=8080

# Optional application settings
FLASK_DEBUG=0
