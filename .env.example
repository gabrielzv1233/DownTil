# Bind to all interfaces when running inside Pterodactyl or Docker.
# HOST defaults to 127.0.0.1 when unset (local-only).
HOST=0.0.0.0

# Set PORT to the allocation assigned to this server in Pterodactyl.
PORT=8080

# Optional application settings
FLASK_DEBUG=0
